NODE_ENV=development
DATABASE_URL=postgresql://jobinfo:change-this-password@localhost:5432/jobinfo_india?schema=public
DATABASE_URL_UNPOOLED=postgresql://jobinfo:change-this-password@localhost:5432/jobinfo_india?schema=public
POSTGRES_PASSWORD=change-this-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Keep stable across restarts; encrypts custom AI provider credentials.
AI_ENCRYPTION_KEY=replace-with-another-at-least-32-random-characters
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Jobinfo India Admin
# OTP provider modes:
# demo: accept any six-digit OTP in development only (never in production)
# console: generate and log an OTP locally
# http-json: send OTP through the configured generic HTTPS JSON adapter
# msg91 / twilio: reserved provider modes; an adapter and credentials are required
OTP_PROVIDER=demo
OTP_DEMO_STAGING_ENABLED=false
NEXT_PUBLIC_OTP_PROVIDER=demo
SMS_API_URL=
# Set PAYMENT_PROVIDER=mock only for local test checkout. Never use in production.
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# For the built-in Razorpay payment-link adapter, set PAYMENT_PROVIDER=razorpay:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST rate in basis points (1800 = 18%). Confirm the applicable rate before live billing.
GST_RATE_BPS=1800
GST_BUSINESS_NAME=Jobinfo India
GSTIN=
GST_ADDRESS=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
FILE_STORAGE=local
UPLOAD_DIR=.data/private-uploads
